{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/product.html",
      "has": [{ "type": "query", "key": "id", "value": "(?<id>.+)" }],
      "destination": "/product/:id",
      "permanent": true
    },
    {
      "source": "/post.html",
      "has": [{ "type": "query", "key": "id", "value": "(?<id>.+)" }],
      "destination": "/journal/:id",
      "permanent": true
    },
    {
      "source": "/product",
      "has": [{ "type": "query", "key": "id", "value": "(?<id>.+)" }],
      "destination": "/product/:id",
      "permanent": true
    },
    {
      "source": "/post",
      "has": [{ "type": "query", "key": "id", "value": "(?<id>.+)" }],
      "destination": "/journal/:id",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ]
}
